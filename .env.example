REDIS_URL=redis://localhost:6379/0
API_BASE_URL=http://localhost:8000/api
# Credentials are read only from the process environment, under their opaque
# names (see src/proactive_agent/credentials.py for the table). This file does
# NOT supply them: export them in the shell (the plain names such as
# ANTHROPIC_API_KEY or DISCORD_BOT_TOKEN are not read at all). For local dev and
# evals, export PROACTIVE_ALLOW_PLAIN_CREDENTIALS=1 and put the plain key value
# under the opaque name; production holds the v1-encoded value instead.
# Exports, not .env lines:
#   FUC9HA  proactive-agent API key      FHI1OT  Discord bot token
#   AO6HUE  Brave search key             IN8OID  Gemini key
#   KMSVP8  Anthropic key                RCGW3A  OpenRouter key
PROACTIVE_AGENT_MODEL=claude-opus-5-5
PROACTIVE_SKIM_MODEL=z-ai/glm-5.3-flash
PROACTIVE_WEB_SUMMARIZER_MODEL=claude-haiku-5-5
PROACTIVE_WEB_SUMMARIZER_FALLBACK_MODEL=gemini-3.5-flash-lite
PROACTIVE_HANDLER_MODEL=claude-opus-5-5
PROACTIVE_IMAGE_REVIEWER_MODEL=claude-haiku-5-5
PROACTIVE_MEDIA_READER_MODEL=gemini-3.5-flash-lite
LITELLM_ENDPOINT=
LITELLM_API_KEY=
PROACTIVE_WORKER_CONCURRENCY=8
PROACTIVE_HISTORY_DEBOUNCE_SECONDS=5
PROACTIVE_HISTORY_FLUSH_TIMEOUT_SECONDS=10
PROACTIVE_LEASE_SECONDS=180
PROACTIVE_RECLAIM_IDLE_SECONDS=240
PROACTIVE_MAX_ATTEMPTS=5
PROACTIVE_HEALTH_PORT=8080
LOG_LEVEL=INFO
