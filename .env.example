REDIS_URL=redis://localhost:6379/0
API_BASE_URL=http://localhost:8000/api
# Credentials are read only from their opaque env var names (see
# src/proactive_agent/credentials.py for the table): the plain names such as
# ANTHROPIC_API_KEY or DISCORD_BOT_TOKEN are NOT read. For local dev and evals
# set PROACTIVE_ALLOW_PLAIN_CREDENTIALS=1 and put the plain key value under the
# opaque name; production holds the v1-encoded value instead.
# Settings reads this file, so the two opaque names below work from it; every
# other key must be exported in the environment.
PROACTIVE_ALLOW_PLAIN_CREDENTIALS=1
FUC9HA=
FHI1OT=
PROACTIVE_AGENT_MODEL=claude-opus-5-5
PROACTIVE_SKIM_MODEL=z-ai/glm-5.3-flash
PROACTIVE_WEB_SUMMARIZER_MODEL=claude-haiku-5-5
PROACTIVE_WEB_SUMMARIZER_FALLBACK_MODEL=gemini-3.5-flash-lite
PROACTIVE_HANDLER_MODEL=gemini-3-flash-preview
PROACTIVE_IMAGE_REVIEWER_MODEL=gemini-3.1-flash-lite
PROACTIVE_MEDIA_READER_MODEL=gemini-3.1-flash-lite
AO6HUE=
IN8OID=
# Direct Claude API key for any claude-* model above (e.g.
# PROACTIVE_AGENT_MODEL=claude-opus-5-5).
KMSVP8=
LITELLM_ENDPOINT=
LITELLM_API_KEY=
PROACTIVE_WORKER_CONCURRENCY=8
PROACTIVE_HISTORY_DEBOUNCE_SECONDS=5
PROACTIVE_HISTORY_FLUSH_TIMEOUT_SECONDS=10
PROACTIVE_LEASE_SECONDS=180
PROACTIVE_RECLAIM_IDLE_SECONDS=240
PROACTIVE_MAX_ATTEMPTS=5
PROACTIVE_HEALTH_PORT=8080
LOG_LEVEL=INFO
